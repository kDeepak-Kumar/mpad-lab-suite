# Copy to .env for local development, or set these in cPanel > Setup Node.js App > Environment variables.
NODE_ENV=production
PORT=4000
# Database: sqlite (local) or mysql (cPanel)
DB_CLIENT=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=cpaneluser_suite
MYSQL_USER=cpaneluser_suite
MYSQL_PASSWORD=
# Long random string used to sign logins (generate one, keep it secret)
JWT_SECRET=
# Set to true when the site is served over https
COOKIE_SECURE=true
# First owner account, created on first start only
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Password of the mailbox configured in Settings > Company > Email
SMTP_PASSWORD=
APP_TIMEZONE=Asia/Kolkata
